# --- Required ---

# Long random string. Used to sign session cookies. Rotate to invalidate all sessions.
SESSION_SECRET=change-me-to-a-long-random-string

# Comma-separated emails granted admin role on first OTP verify.
ADMIN_EMAILS=you@example.com

# --- Email (Resend) ---
# Get a key at https://resend.com. Leave RESEND_API_KEY blank during dev with DEV_OTP_LOG=true.
RESEND_API_KEY=
RESEND_FROM=WFSF <onboarding@resend.dev>

# --- Bot protection (Cloudflare Turnstile) ---
# Optional. Both must be set to enable the single-checkbox CAPTCHA on login.
# Create a free "Managed" widget: Cloudflare dashboard → Turnstile → Add widget,
# add your domain (and 127.0.0.1 for local testing). Leave blank to disable.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Optional ---

# Public-facing base URL. Used in OTP email links.
APP_BASE_URL=http://localhost:10000

# Server bind. Default 0.0.0.0:10000.
APP_HOST=0.0.0.0
APP_PORT=10000

# When true, OTPs are logged to stdout instead of (or in addition to) email — for dev only.
DEV_OTP_LOG=true

# OTP policy
OTP_TTL_MINUTES=10
OTP_MAX_PER_HOUR=5
OTP_MAX_BAD_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# Session lifetime
SESSION_TTL_DAYS=30

# Sync intervals (minutes)
SYNC_INTERVAL_NORMAL_MINUTES=60
SYNC_INTERVAL_EVENT_MINUTES=15
